# Copy to .env and change the password. Minimum 8 characters or the server refuses to boot.
CREW_PASSWORD=change-me-please

# Port the server listens on (API + built client in production).
PORT=3001

# ONLY set this if you serve over https. It flips the session cookie to Secure.
# Leaving it unset is correct for plain-http LAN use - a Secure cookie over
# http://192.168.x.x is silently dropped by the browser and nothing will log in.
# PUBLIC_ORIGIN=https://pizza.example.com
